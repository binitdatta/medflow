# ---------- Flask ----------
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=true
API_BASE_URL=http://localhost:5000

# ---------- MySQL 8.x ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=medflow_app
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=medflow

# ---------- Keycloak 26 ----------
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=medflow
KEYCLOAK_PUBLIC_CLIENT_ID=medflow-web
# Confidential client, used server-side to validate/introspect tokens and for bash script testing
KEYCLOAK_CONFIDENTIAL_CLIENT_ID=medflow-service
KEYCLOAK_CONFIDENTIAL_CLIENT_SECRET=change-me-service-secret
KEYCLOAK_REDIRECT_URI=http://localhost:5000/auth/callback

# ---------- LLM (LangGraph agent) ----------
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6
