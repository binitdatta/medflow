{
  "realm": "medflow",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      { "name": "PHYSICIAN",  "description": "Attending/treating physician" },
      { "name": "NURSE",      "description": "Bedside nursing staff" },
      { "name": "PHARMACIST", "description": "Pharmacy staff" },
      { "name": "ADMISSIONS", "description": "Registration / admissions staff" },
      { "name": "FINANCE",    "description": "Billing / revenue cycle staff (Phase 2)" },
      { "name": "MANAGEMENT", "description": "Hospital group management / executives (Phase 2)" },
      { "name": "LEGAL",      "description": "Legal / compliance / audit staff (Phase 2)" },
      { "name": "ADMIN",      "description": "System / integration test account" }
    ]
  },

  "clients": [
    {
      "clientId": "medflow-web",
      "name": "MedFlow Web (Browser, PKCE)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5000/*"
      ],
      "webOrigins": [
        "http://localhost:5000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "medflow-service",
      "name": "MedFlow Service (Confidential — bash/script testing)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "change-me-service-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "client_credentials.use_refresh_token": "false"
      }
    }
  ],

  "users": [
    {
      "id": "b1a1c2d3-1111-4a4a-8a8a-000000000001",
      "username": "nurse1",
      "email": "nurse1@medflow.example",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Angela",
      "lastName": "Reyes",
      "credentials": [
        { "type": "password", "value": "Nurse123!", "temporary": false }
      ],
      "realmRoles": ["NURSE"]
    },
    {
