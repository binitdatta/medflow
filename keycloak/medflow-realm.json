      "enabled": true,
      "emailVerified": true,
      "firstName": "Marcus",
      "lastName": "Chen",
      "credentials": [
        { "type": "password", "value": "Pharm123!", "temporary": false }
      ],
      "realmRoles": ["PHARMACIST"]
    },
    {
      "id": "b1a1c2d3-1111-4a4a-8a8a-000000000003",
